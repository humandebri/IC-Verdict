/target/
/build/
/.dfx/
/.venv/
/checkpoints/
# Downloaded checkpoints and scratch ICP homes. Large binaries that must never be
# committed: models/verdict-151m is a 605 MB (577 MiB) safetensors file.
/models/
/.icphome/
# icp-cli local network state: replica cache and canister id mappings.
/.icp/
__pycache__/
*.pyc
# Cargo.lock is intentionally NOT ignored. Generate, review, and commit it.
# Self-contained Cargo registry for tools/verdict-upload (ic-agent is not in the
# default cache); a cache, not a source.
.cargohome/
# The tiny fixture pack is committed (108 KB total) so a fresh clone can validate it:
# `tools/make_verdict_fixture.py --check` re-reads these bytes, and `tools/verify.py`
# runs that check. Generation is still available for changes (`--write` side).
# Scratch: the `ax` fetch cache and the downloaded upstream source used to read the
# reference implementation. Neither is project source.
/.cache/
/.axtmp/
# Frontend dependencies, builds, test coverage and compiler caches.
node_modules/
/web/**/dist/
/web/**/coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files are local by default. These two contain public config only.
.env
.env.*
!/web/tetris/.env.example
!/web/tetris/.env.production
.dev.vars
.dev.vars.*

# Browser/Cloudflare local state and generated logs. Small measurement records stay tracked.
/.playwright-cli/
.wrangler/
/artifacts/**/*.log

# macOS metadata, including AppleDouble files on external volumes.
.DS_Store
._*

